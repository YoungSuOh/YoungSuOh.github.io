      "Bash(node -e \"const a=require\\('./data/posts.json'\\); console.log\\(JSON.stringify\\(a.slice\\(0,4\\).map\\(x=>\\({id:x.id,slug:x.slug,cat:x.category,date:x.date}\\)\\),null,1\\)\\)\")",
